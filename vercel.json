{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install && npm install --prefix apps/web",
  "buildCommand": "npm run build --prefix apps/web",
  "outputDirectory": "apps/web/.next",
  "functions": {
    "api/index.py": {
      "includeFiles": "{apps/api/**,packages/**,data/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {"source": "/health", "destination": "/api/index"},
    {"source": "/demo-cases", "destination": "/api/index"},
    {"source": "/demo-cases/:path*", "destination": "/api/index"},
    {"source": "/cases/:path*", "destination": "/api/index"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
